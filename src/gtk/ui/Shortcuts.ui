<?xml version="1.0" encoding="UTF-8"?>
<interface>
  <object class="AdwShortcutsDialog" id="shortcuts">
    <child>
      <object class="AdwShortcutsSection">
        <property name="title" translatable="yes">General</property>            
        <child>
          <object class="AdwShortcutsItem">                
            <property name="title" translatable="yes">Quit</property>
            <property name="action-name">app.quit</property>
          </object>
        </child>
        <child>
          <object class="AdwShortcutsItem">
            <property name="accelerator">&lt;Ctrl&gt;C</property>                
            <property name="title" translatable="yes">Clear the dice display</property>
          </object>
        </child>
        <child>
          <object class="AdwShortcutsItem">
            <property name="accelerator">&lt;Ctrl&gt;E</property>                
            <property name="title" translatable="yes">Clear the roll logs</property>
          </object>
        </child>
        <child>
          <object class="AdwShortcutsItem">
            <property name="accelerator">&lt;Ctrl&gt;P</property>                
            <property name="title" translatable="yes">Toggle panel visibility</property>
          </object>
        </child>
        <child>
          <object class="AdwShortcutsItem">
            <property name="accelerator">&lt;Ctrl&gt;M</property>                
            <property name="title" translatable="yes">Toggle command mode</property>
          </object>
        </child>
        <child>
          <object class="AdwShortcutsItem">
            <property name="accelerator">&lt;Ctrl&gt;R</property>
            <property name="title" translatable="yes">Perform dice roll</property>
          </object>
        </child>            
      </object>
    </child>
      <child>
        <object class="AdwShortcutsSection">            
          <property name="title" translatable="yes">Additions and subtractions</property>
          <child>
            <object class="AdwShortcutsItem">
              <property name="accelerator">&lt;Ctrl&gt;plus</property>
              <property name="title" translatable="yes">Add increment (+1)</property>
            </object>
          </child>
          <child>
            <object class="AdwShortcutsItem">
              <property name="accelerator">&lt;Ctrl&gt;minus</property>
              <property name="title" translatable="yes">Add decrement (-1)</property>
            </object>
          </child>
        </object>
      </child>         
      <child>
        <object class="AdwShortcutsSection">            
          <property name="title" translatable="yes">Dice</property>
          <child>
            <object class="AdwShortcutsItem">
              <property name="accelerator">&lt;Ctrl&gt;3</property>
              <property name="title" translatable="yes">Add a Fudge Die</property>
            </object>
          </child>
          <child>
            <object class="AdwShortcutsItem">
              <property name="accelerator">&lt;Ctrl&gt;4</property>
              <property name="title" translatable="yes">Add a d4</property>
            </object>
          </child>
          <child>
            <object class="AdwShortcutsItem">
              <property name="accelerator">&lt;Ctrl&gt;6</property>
              <property name="title" translatable="yes">Add a d6</property>
            </object>
          </child>
          <child>
            <object class="AdwShortcutsItem">
              <property name="accelerator">&lt;Ctrl&gt;8</property>
              <property name="title" translatable="yes">Add a d8</property>
            </object>
          </child>
          <child>
            <object class="AdwShortcutsItem">
              <property name="accelerator">&lt;Ctrl&gt;0</property>
              <property name="title" translatable="yes">Add a d10</property>
            </object>
          </child>
          <child>
            <object class="AdwShortcutsItem">
              <property name="accelerator">&lt;Ctrl&gt;9</property>
              <property name="title" translatable="yes">Add a d12</property>
            </object>
          </child>
          <child>
            <object class="AdwShortcutsItem">
              <property name="accelerator">&lt;Ctrl&gt;2</property>
              <property name="title" translatable="yes">Add a d20</property>
            </object>
          </child>
          <child>
            <object class="AdwShortcutsItem">
              <property name="accelerator">&lt;Ctrl&gt;1</property>
              <property name="title" translatable="yes">Add a d100</property>
            </object>
          </child>
        </object>
      </child>  
  </object>
</interface>