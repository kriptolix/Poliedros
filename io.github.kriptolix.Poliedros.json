{
    "id" : "io.github.kriptolix.Poliedros",
    "runtime" : "org.gnome.Platform",
    "runtime-version" : "50",
    "sdk" : "org.gnome.Sdk",
    "command" : "poliedros",
    "finish-args" : [        
        "--share=ipc",
        "--socket=fallback-x11",
        "--device=dri",
        "--socket=wayland"
    ],
    "cleanup" : [
        "/include",
        "/lib/pkgconfig",
        "/man",
        "/share/doc",
        "/share/gtk-doc",
        "/share/man",
        "/share/pkgconfig",
        "*.la",
        "*.a"
    ],
    "modules" : [
        "requirements/meson-python.json",
        "requirements/pyopengl.json",
        "requirements/pyopengl-accelerate.json",
        "requirements/sounddevice.json",
        "requirements/numpy.json",
        "requirements/pybullet.json",                      
        {
            "name" : "poliedros",
            "builddir" : true,
            "buildsystem" : "meson",
            "sources" : [
                {
                    "type" : "git",
                    "url" : "https://github.com/kriptolix/Poliedros.git",
                    "tag" : "v1.5.3",
                    "commit": "5f9c7f4"
                }
            ]
        }
    ]
}
